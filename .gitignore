# Local .terraform directories
**/.terraform/*

# .tfstate files (state lives in S3 remote backend, never local)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# CLI configuration files
.terraformrc
terraform.rc

# macOS
.DS_Store
